{
  "schemaVersion": 1,
  "id": "focus-7",
  "version": "1.1.0",
  "name": "7-day focus sprint",
  "durationDays": 7,
  "calendar": { "timeZone": "America/New_York", "weekStartsOn": 1 },
  "parameters": {
    "focus-minutes": { "label": "Focused minutes per day", "default": 20, "min": 1, "max": 240 }
  },
  "actions": [
    { "id": "focus", "label": "Complete your focused work session", "type": "number", "unit": "minutes", "integer": true, "cadence": "daily", "target": { "parameter": "focus-minutes" }, "requiredForDay": true }
  ],
  "consistency": { "graceDays": 1, "graceMode": "bridge" },
  "milestones": [
    { "at": 1, "label": "Started" },
    { "at": 3, "label": "Building" },
    { "at": 7, "label": "Finished" }
  ],
  "coach": {
    "promptFile": "coach.md",
    "responseVersion": 1,
    "visibleFields": [
      "enrollment.startDate",
      "enrollment.parameters.focus-minutes",
      "enrollment.context.goal",
      "enrollment.context.startingPoint",
      "enrollment.context.constraints",
      "progress.asOfDate",
      "progress.endDate",
      "progress.dayNumber",
      "progress.completedDays",
      "progress.consistencyDays",
      "progress.graceUsed",
      "progress.graceRemaining",
      "progress.tier",
      "progress.days[].date",
      "progress.days[].status",
      "progress.days[].complete",
      "progress.days[].missingActions",
      "progress.days[].values.focus"
    ]
  }
}
